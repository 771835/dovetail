include "minecraft.mcdl"

// ── 直接递归：阶乘 ──────────────────────────────────────────────────────────

fn fact(n: int) -> int {
    if (n <= 1) {
        return 1
    }
    return n * fact(n - 1)
}

// ── 直接递归：斐波那契（非尾递归，两次自调用） ─────────────────────────────

fn fib(n: int) -> int {
    if (n <= 2) {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

