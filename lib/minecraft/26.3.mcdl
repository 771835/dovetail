fn clear(targets: string, item: string = "", maxCount: string = "") {
    if (item == "") {
        exec(f"clear {targets}")
    } else if (maxCount == "") {
        exec(f"clear {targets} {item}")
    } else {
        exec(f"clear {targets} {item} {maxCount}")
    }
}

