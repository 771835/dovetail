// ────────────────────────────────────────────────────────────
// teleport
// ────────────────────────────────────────────────────────────

fn teleport(targets: string, location: string = "", rotation: string = "", destination: string = "") {
    if (location == "") {
        exec(f"teleport {destination}")
    } else if (targets == "") {
        exec(f"teleport {location}")
    } else if (location == "") {
        exec(f"teleport {targets} {destination}")
    } else if (rotation == "") {
        exec(f"teleport {targets} {location}")
    } else {
        exec(f"teleport {targets} {location} {rotation}")
    }
}

fn teleport_facing_entity(targets: string, location: string, facingEntity: string, facingAnchor: string = "") {
    if (facingAnchor == "") {
        exec(f"teleport {targets} {location} facing entity {facingEntity}")
    } else {
        exec(f"teleport {targets} {location} facing entity {facingEntity} {facingAnchor}")
    }
}

fn teleport_facing(targets: string, location: string, facingLocation: string) {
    exec(f"teleport {targets} {location} facing {facingLocation}")
}

