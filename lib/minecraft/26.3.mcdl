fn datapack_create(id: string, description: string) {
    exec(f"datapack create {id} {description}")
}

fn datapack_disable(name: string) {
    exec(f"datapack disable {name}")
}

fn datapack_enable(name: string) {
    exec(f"datapack enable {name}")
}

fn datapack_enable_after(name: string, existing: string) {
    exec(f"datapack enable {name} after {existing}")
}

fn datapack_enable_before(name: string, existing: string) {
    exec(f"datapack enable {name} before {existing}")
}

fn datapack_enable_first(name: string) {
    exec(f"datapack enable {name} first")
}

fn datapack_enable_last(name: string) {
    exec(f"datapack enable {name} last")
}

fn datapack_list() {
    exec(f"datapack list")
}

fn datapack_list_available() {
    exec(f"datapack list available")
}

fn datapack_list_enabled() {
    exec(f"datapack list enabled")
}

