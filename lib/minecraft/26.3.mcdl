fn advancement_grant_everything(targets: string) {
    exec(f"advancement grant {targets} everything")
}

fn advancement_grant_from(targets: string, advancement: string) {
    exec(f"advancement grant {targets} from {advancement}")
}

fn advancement_grant_only(targets: string, advancement: string, criterion: string = "") {
    if (criterion == "") {
        exec(f"advancement grant {targets} only {advancement}")
    } else {
        exec(f"advancement grant {targets} only {advancement} {criterion}")
    }
}

fn advancement_grant_through(targets: string, advancement: string) {
    exec(f"advancement grant {targets} through {advancement}")
}

fn advancement_grant_until(targets: string, advancement: string) {
    exec(f"advancement grant {targets} until {advancement}")
}

fn advancement_revoke_everything(targets: string) {
    exec(f"advancement revoke {targets} everything")
}

fn advancement_revoke_from(targets: string, advancement: string) {
    exec(f"advancement revoke {targets} from {advancement}")
}

fn advancement_revoke_only(targets: string, advancement: string, criterion: string = "") {
    if (criterion == "") {
        exec(f"advancement revoke {targets} only {advancement}")
    } else {
        exec(f"advancement revoke {targets} only {advancement} {criterion}")
    }
}

