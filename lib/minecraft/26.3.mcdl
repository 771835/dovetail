fn place_template(template: string, pos: string = "", rotation: string = "", mirror: string = "", integrity: string = "", seed: string = "") {
    if (pos == "") {
        exec(f"place template {template}")
    } else if (rotation == "") {
        exec(f"place template {template} {pos}")
    } else if (mirror == "") {
        exec(f"place template {template} {pos} {rotation}")
    } else if (integrity == "") {
        exec(f"place template {template} {pos} {rotation} {mirror}")
    } else if (seed == "") {
        exec(f"place template {template} {pos} {rotation} {mirror} {integrity}")
    } else {
        exec(f"place template {template} {pos} {rotation} {mirror} {integrity} {seed}")
    }
}

