    if (arguments == "") {
        exec(f"function {name}")
    } else {
        exec(f"function {name} {arguments}")
    }
}

fn function_with_block(name: string, source: string, path: string = "") {
    if (path == "") {
        exec(f"function {name} with block {source}")
    } else {
        exec(f"function {name} with block {source} {path}")
    }
}

fn function_with_entity(name: string, source: string, path: string = "") {
    if (path == "") {
        exec(f"function {name} with entity {source}")
    } else {
        exec(f"function {name} with entity {source} {path}")
    }
}

fn function_with_storage(name: string, source: string, path: string = "") {
    if (path == "") {
        exec(f"function {name} with storage {source}")
    } else {
        exec(f"function {name} with storage {source} {path}")
    }
}

