// fraction.mcdl -  测试性的基于分数的浮点数实现
include "mathlib.mcdl"

class Fraction {
    let numerator: int
    let denominator: int

    method __init__(self: Fraction, num: int, den: int) {
        if (den == 0) {
            den = 1
        }

        let gcd_val: int = gcd(abs(num), abs(den))
        self.numerator = num / gcd_val
        self.denominator = den / gcd_val

        if (self.denominator < 0) {
            self.numerator = -self.numerator
            self.denominator = -self.denominator
        }
    }

    method add(self: Fraction, other: Fraction): Fraction {
        return Fraction(
            self.numerator * other.denominator + other.numerator * self.denominator,
            self.denominator * other.denominator
        )
    }

    method subtract(self: Fraction, other: Fraction): Fraction {
        return Fraction(
            self.numerator * other.denominator - other.numerator * self.denominator,
            self.denominator * other.denominator
        )
    }

    method multiply(self: Fraction, other: Fraction): Fraction {
        return Fraction(self.numerator * other.numerator, self.denominator * other.denominator)
    }

    method divide(self: Fraction, other: Fraction): Fraction {
        return Fraction(self.numerator * other.denominator, self.denominator * other.numerator)
    }

    method square_root(self: Fraction): Fraction {
        return Fraction(isqrt(self.numerator), isqrt(self.denominator))
    }

    method exponential(self: Fraction): Fraction {
        // 泰勒级数近似 exp(x)
        Fraction result = Fraction(1, 1)
        Fraction term = Fraction(1, 1)
        Fraction x = Fraction(self.numerator, self.denominator)

        for (let i = 1; i <= 8; i = i + 1) {
            term = term.multiply(x).divide(Fraction(i, 1))
            result = result.add(term)

            if (result.denominator > 100000) {
                result = Fraction(result.numerator / 100, result.denominator / 100)
            }
        }
        return result
    }

    method to_scaled_int(self: Fraction): int {
        return (self.numerator * 10000) / self.denominator
    }
}
// 测试辅助函数：使用计分板显示数值
fn display_fraction(f: Fraction, name: string) {
    // 在 Minecraft 中使用计分板显示分子和分母
    // 假设有预定义的计分板 "numerator" 和 "denominator"
    let n: int = f.numerator
    let d: int = f.denominator
    print(f"{name}:{n}/{d}")
}