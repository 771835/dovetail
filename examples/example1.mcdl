include "builtins"
include "minecraft.mcdl"
include "math"

typedef int i32

fn foo() -> i32;

@init
fn beef(){
    if (foo()==INT_MAX) {
        say("qwq")
        print("1")
    }else {
        say("2")
        abs(1)
    }
}

@target("java")
fn foo() -> i32{
    return INT_MAX
}

@target("be")
fn foo() -> i32{
    return INT_MIN
}
